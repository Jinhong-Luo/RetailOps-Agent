{
  "名称": "冻结新版后的全量评测展示矩阵",
  "状态": "预排期，尚无新分数。先完成 ECom 候选版本验收，冻结后再运行。",
  "行数": 113,
  "模块列": [
    "多需求登记",
    "同轮咨询",
    "预约等待与恢复",
    "上下文与检索",
    "跨会话记忆",
    "草案展示、授权和执行",
    "多会话服务与恢复",
    "评测流程本身"
  ],
  "读法": {
    "业务配对": "同一参照与只改本列条件的版本都跑本数据集所有适配的业务题，不按历史成功或本次触发选题。",
    "记忆配对": "主表比较冻结笔记与无记忆。记忆在某个环境未注入时，记录可用性与命中，继续保留该环境业务结果；专题另比人工提示及原文。",
    "上下文组合配对": "以冻结参照对预先定义的基础上下文。不同域保留同一底层政策与目录，准确命名启用的增量组件。τ商品分页/真正的政策章节查找只在相应环境考察；短窗证据在D10额外单独配对。",
    "同接口旧版配对": "回退草案展示/执行改进到经验证可工作的旧实现，保持同一授权接口与业务账本。冻结对照版本和回退清单后运行，按整组解释；若无兼容对照，列待接通。执行故障注入只在隔离副本。",
    "服务轨迹回放": "从各题的服务端事件和请求重建运行，固定相同输入和故障位置，比较现行与对照实现。读请求可测试超时、取消、会话隔离；退款重试只对有合法退款的轨迹计。需要观测量不足时列缺证，保留原题。",
    "评分轨迹复核": "对同一归档输入，使用预定正确判分作外部参照，检查评分一致和分母/版本异常。不得让被评测的流程自行修改官方分。仅有配置或无业务状态时只评适用的断言。",
    "环境无独立登记/环境无预约": "题号仍保留。如需完整记录运行两臂，标记适配器上配置等价；复用同指纹记录时标注复用，不记作独立观测。",
    "固定输入无该开关": "题型固定了草案、执行或轨迹；上游模块在这个接口没有处理机会。可在该版本重复相同输入做一致性检查，主结论记不适用。",
    "展示配对/执行配对": "按共享题既定两种展示或两种执行配置运行。D18每个配置含完整和残缺两笔回放。"
  },
  "计分": "公开官方结果分别用50/33为整题分母，共享业务、盲评、回放分开。某模块在可运行任务中未触发仍在全量业务分母内，触发率单列。不同工作类型不汇算总正确率。",
  "复用": "同题、同版本、同输入、同环境、同评分和采样条件的同一参照轨迹复用一次；不同短窗/固定前缀要单跑。63个专测与联测位置按完全匹配条件去重。",
